# OUHVE ABM — Environment Configuration Example
# Copy to .env and fill in actual values

# === Database ===
DATABASE_URL=postgresql://ouhve:ouhve_dev@localhost:5432/ouhve

# === Session Security ===
# Generate: openssl rand -hex 32
SESSION_SECRET=

# === Site Gate (HMAC) ===
# Owner + delegate access password (set fresh, do NOT reuse GLFAV value)
SITE_PASSWORD=
# Generate: openssl rand -hex 32
SITE_AUTH_SECRET=

# === Environment ===
NODE_ENV=development

# === Optional: PG connection details ===
PGHOST=localhost
PGPORT=5432
PGUSER=ouhve
PGPASSWORD=ouhve_dev
PGDATABASE=ouhve

# === CORS / Origins ===
ALLOWED_ORIGINS=http://localhost:5000

# === Monitoring ===
LOG_LEVEL=info
ENABLE_PERFORMANCE_MONITORING=true

# === Payment (Billgate) — leave empty until OUHVE PG contract signed ===
BILLGATE_MERCHANT_ID=
BILLGATE_LICENSE_KEY=

# === AI (Claude) — for chatbot/agent features ===
ANTHROPIC_API_KEY=

# === Notitalk (Dozn) — for KakaoTalk notifications ===
DOZN_API_KEY=
DOZN_SENDER_KEY=
